  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="node_trans_uralic_2" value="&lt;b&gt;LEGENDA &amp;amp; CONVENÇÕES&lt;/b&gt;&lt;br&gt;🟢 &lt;b&gt;Verde:&lt;/b&gt; Língua Viva / Ativa&lt;br&gt;🔴 &lt;b&gt;Vermelho/Rosa:&lt;/b&gt; Língua Extinta / Histórica (†)&lt;br&gt;⚪ &lt;b&gt;Branco:&lt;/b&gt; Protolíngua / Nó de Ramificação&lt;br&gt;🔵 &lt;b&gt;Azul:&lt;/b&gt; Macrofamília / Subfamília Principal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="90" as="geometry"/></mxCell>
    <mxCell id="node_trans_uralic_3" value="&lt;b&gt;ÁRVORE FILOGENÉTICA DAS PROTOLÍNGUAS TRANSEURASIÁTICAS, URÁLICAS &amp;amp; CAUCÁSICAS&lt;/b&gt;&lt;br&gt;&lt;i&gt;Reconstruções: Proto-Túrquico, Proto-Mongólico, Proto-Tungúsico, Proto-Japônico, Proto-Coreano, Proto-Urálico e Proto-Kartveliano&lt;/i&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;Baseado em Cole (2026), Robbeets (Transeurasian phylogenetics), Johanson &amp;amp; Csató, Janhunen &amp;amp; Campbell&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;strokeColor=#0f172a;fontColor=#ffffff;fontSize=14;fontStyle=1;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="880" height="65" as="geometry"/></mxCell>
