    <mxCell id="node_americas_2" value="&lt;b&gt;LEGENDA &amp;amp; CONVENÇÕES&lt;/b&gt;&lt;br&gt;🟢 &lt;b&gt;Verde:&lt;/b&gt; Língua Viva / Ativa&lt;br&gt;🔴 &lt;b&gt;Vermelho/Rosa:&lt;/b&gt; Língua Extinta / Histórica (†)&lt;br&gt;⚪ &lt;b&gt;Branco:&lt;/b&gt; Protolíngua / Nó de Ramificação&lt;br&gt;🔵 &lt;b&gt;Azul:&lt;/b&gt; Macrofamília / Subfamília Principal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="90" as="geometry"/></mxCell>
